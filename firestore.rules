// ---------------------------------------------------------------------------
// firestore.rules
// Regras de segurança do Cloud Firestore - Controle de SLA de Pedidos UNISO
// ---------------------------------------------------------------------------
// Objetivo: impedir qualquer acesso (leitura ou escrita) de usuários não
// autenticados. A autenticação usada pelo app é a "Anônima" do Firebase
// (sem tela de login visível), portanto qualquer sessão válida do app já
// possui request.auth != null.
// ---------------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de pedidos: leitura e escrita liberadas somente para
    // usuários autenticados (inclui autenticação anônima).
    match /pedidos/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Coleção de colaboradores (separadores e organizadores cadastrados,
    // usados nas listas suspensas do Registro de Separação/Organização e
    // das correções manuais em "Editar Pedido"): mesma regra da coleção de
    // pedidos.
    match /colaboradores/{colaboradorId} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia por padrão qualquer outra coleção/documento não previsto
    // explicitamente acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
